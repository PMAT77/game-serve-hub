# Public docs: track guides only; other paths under docs/ stay local
docs/*
!docs/README.md
!docs/INSTALL.md
!docs/DEVELOPMENT.md
!docs/RELEASE.md
!docs/MEMORY.md
!docs/IMAGE_DISTRIBUTION.md
!docs/ARCHITECTURE.md
!docs/assets/
!docs/assets/**
!docs/images/
!docs/images/**

# Local runtime data & logs
server/data/
server/logs/
data/
logs/
*.sqlite*
**/install-logs/
debug-*.log
*.ndjson

# 历史测试残留（bug 产物：路径变量为 undefined 时落盘的目录）
undefined/

# Environment & secrets (track only *.example templates)
.env
.env.*
!.env.*.example
server/.env
server/.env.*
!server/.env.*.example
panel.env
.dev/

# IDE & local tooling
.agents/
.skills/
skills/
.cursor/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test / coverage
coverage/
.nyc_output/

