{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "game-server-hub-design-tokens",
    "version": "1.0.0",
    "source": "apps/game-server-hub-standalone + packages/themes",
    "colorSpace": "oklch"
  },
  "color": {
    "light": {
      "background": "1 0 0",
      "foreground": "0.141 0.005 285.823",
      "card": "1 0 0",
      "cardForeground": "0.141 0.005 285.823",
      "popover": "1 0 0",
      "popoverForeground": "0.141 0.005 285.823",
      "primary": "0.21 0.006 285.885",
      "primaryForeground": "0.985 0 0",
      "secondary": "0.967 0.001 286.375",
      "secondaryForeground": "0.21 0.006 285.885",
      "muted": "0.967 0.001 286.375",
      "mutedForeground": "0.552 0.016 285.938",
      "accent": "0.967 0.001 286.375",
      "accentForeground": "0.21 0.006 285.885",
      "destructive": "0.577 0.245 27.325",
      "border": "0.92 0.004 286.32",
      "input": "0.92 0.004 286.32",
      "ring": "0.705 0.015 286.067",
      "mainAreaBg": "0.9612 0 0"
    },
    "dark": {
      "background": "0.141 0.005 285.823",
      "foreground": "0.985 0 0",
      "card": "0.21 0.006 285.885",
      "cardForeground": "0.985 0 0",
      "popover": "0.21 0.006 285.885",
      "popoverForeground": "0.985 0 0",
      "primary": "0.92 0.004 286.32",
      "primaryForeground": "0.21 0.006 285.885",
      "secondary": "0.274 0.006 286.033",
      "secondaryForeground": "0.985 0 0",
      "muted": "0.274 0.006 286.033",
      "mutedForeground": "0.705 0.015 286.067",
      "accent": "0.274 0.006 286.033",
      "accentForeground": "0.985 0 0",
      "destructive": "0.704 0.191 22.216",
      "border": "0.252 0.002 286.27",
      "input": "0.341 0 0",
      "ring": "0.552 0.016 285.938"
    },
    "status": {
      "success": "#10b981",
      "warning": "#f59e0b",
      "danger": "#ef4444",
      "info": "#3b82f6",
      "neutral": "#94a3b8"
    },
    "layout": {
      "headerBg": "oklch(var(--background))",
      "headerColor": "oklch(var(--foreground))",
      "headerMenuActiveBg": "oklch(var(--primary))",
      "mainSidebarBg": "oklch(var(--background))",
      "subSidebarBg": "oklch(var(--background))",
      "tabbarBg": "oklch(var(--background))",
      "toolbarBg": "oklch(var(--background))"
    },
    "chart": {
      "axis": "#94a3b8",
      "gridLine": "oklch(var(--border))",
      "upstream": "#10b981",
      "downstream": "#3b82f6"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif",
      "mono": "'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px"
    },
    "lineHeight": {
      "tight": 1.25,
      "normal": 1.5,
      "relaxed": 1.625
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "radius": {
    "none": "0",
    "sm": "calc(var(--radius) - 4px)",
    "md": "calc(var(--radius) - 2px)",
    "lg": "var(--radius)",
    "xl": "calc(var(--radius) + 4px)",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.06)",
    "md": "0 8px 20px rgba(0, 0, 0, 0.12)",
    "xl": "0 20px 40px rgba(0, 0, 0, 0.18)"
  },
  "layout": {
    "headerHeight": "60px",
    "mainSidebarWidth": "80px",
    "subSidebarWidth": "220px",
    "subSidebarCollapseWidth": "64px",
    "sidebarLogoHeight": "50px",
    "tabbarHeight": "50px",
    "toolbarHeight": "50px"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  }
}
