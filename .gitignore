# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist-*/
dist-test/
*.tsbuildinfo
packages/*/dist/

# Internal documentation (not published in open-source repo)
docs_local/

# Public docs: track guides only; other paths under docs/ stay local
docs/*
!docs/README.md
!docs/INSTALL.md
!docs/DEVELOPMENT.md
!docs/RELEASE.md
!docs/MEMORY.md
!docs/IMAGE_DISTRIBUTION.md
!docs/assets/
!docs/assets/**
!docs/images/
!docs/images/**

# Local runtime data & logs
server/data/
server/logs/
data/
logs/
*.sqlite*
**/install-logs/
debug-*.log
*.ndjson

# Environment & secrets (track only *.example templates)
.env
.env.*
!.env.*.example
server/.env
server/.env.*
!server/.env.*.example
panel.env
.dev/

# IDE & local tooling
.agents/
.skills/
skills/
.cursor/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test / coverage
coverage/
.nyc_output/

# Vite / tooling cache
.vite/
