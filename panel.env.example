# Copy to panel.env for docker compose (install script writes panel.env automatically).
PANEL_PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
FORCE_PASSWORD_CHANGE=1
GSH_EDITION=community
DOCKER_HOST=unix:///var/run/docker.sock
GSH_GAME_DST_IMAGE=ghcr.io/pmat77/game-server-hub-dst:latest
GSH_STEAMCMD_IMAGE=cm2network/steamcmd:root
PANEL_IMAGE=ghcr.io/pmat77/game-server-hub:latest
