# 复制为 panel.env 后用于 docker compose（安装脚本会自动写入 panel.env）。
# Copy to panel.env for docker compose (install.linux.sh writes panel.env automatically).
# dev:compose 与 dev:server 请勿同时运行，以免 instances 卷 bind 解析冲突。
PANEL_PORT=8888
# 面板容器时区；计划任务 daily「每日 HH:MM」按该时区执行，默认 Asia/Shanghai，海外服务器按需覆盖
# TZ=Asia/Shanghai
# dev:compose 前端（Vite）端口；系统设置中的「面板端口」在开发模式会同步到该值
VITE_DEV_WEB_PORT=9527
# dev:compose 默认不打印每条 HTTP 请求；排查 API 时可设 LOG_LEVEL=debug
# LOG_LEVEL=info
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=123456
# 找回密码：在 panel.env 设置至少 16 位的 GSH_PASSWORD_RECOVERY_TOKEN 后，登录页「忘记密码」可在线重置
# GSH_PASSWORD_RECOVERY_TOKEN=your-long-random-recovery-token
# 紧急同步：将 ADMIN_PASSWORD 写回数据库后重启（用完后改回 0）
# GSH_SYNC_ADMIN_PASSWORD_FROM_ENV=0
# 安装时为管理员标记「首次登录须改密」；启用后面板会拦截至 /force-change-password 完成改密
FORCE_PASSWORD_CHANGE=1
GSH_EDITION=community
DOCKER_HOST=unix:///var/run/docker.sock
GSH_GAME_DST_IMAGE=ghcr.io/pmat77/game-server-hub:v0.3.1
# SteamCMD 完整镜像引用；v0.2.2 起与 PANEL_IMAGE 一致（统一镜像），保留以便旧配置平滑迁移。
GSH_STEAMCMD_IMAGE=ghcr.io/pmat77/game-server-hub:v0.3.1
# 备选 registry 候选（逗号分隔，按顺序优先尝试；未配置时仅走主引用）：
# GSH_IMAGE_MIRRORS=your-mirror-1.example.com,your-mirror-2.example.com
# 可选：部分未来游戏若 anonymous 不可用，可配置 Steam 账号（343050 不需要）
# STEAMCMD_USERNAME=your_steam_account
# STEAMCMD_PASSWORD=your_steam_password
# 可选：SteamCMD 子容器运行用户，默认 1000:1000；userns-remap / 需 root 写卷时可设 0:0
# GSH_STEAMCMD_RUN_USER=1000:1000
# 可选：RHEL/CentOS SELinux 下卷挂载追加选项，如 rw,z
# GSH_STEAMCMD_BIND_OPTS=rw,z
# 内存档位与预设（small / medium / large）：见 docs/MEMORY.md 与 config/panel.env.presets/
# 安装脚本默认 GSH_PANEL_ENV_PRESET=auto 会按总内存合并对应预设；勿将小内存预设与 dev 压力测试大上限混用
# SteamCMD / DST 子容器内存硬上限（MiB）：默认不设置 = 不限制，高配机可跑满 mod 等场景
# 非预留；仅小内存机/WSL2 建议显式设上限，防止 vmmem 冲高
# GSH_STEAMCMD_CONTAINER_MEMORY_MB=2048
# GSH_DST_CONTAINER_MEMORY_MB=8192
# 安装前守卫按「典型峰值」估算（默认约 1280+512 MiB 可用内存），与硬上限无关
# GSH_HOST_STEAMCMD_PLANNING_MB=1280
# GSH_HOST_MEMORY_HEADROOM_MB=512
# GSH_HOST_MIN_AVAILABLE_MB=0
# --- 小内存机请用预设文件（推荐），勿手抄易错 ---
# config/panel.env.presets/small.env   # 约 4 GiB
# config/panel.env.presets/medium.env  # 约 6 GiB
# config/panel.env.presets/large.env   # ≥ 8 GiB（默认不设硬上限）
# --- 备份与恢复 ---
# 备份根目录（存档 tar.gz 与数据库快照落盘位置；docker-compose 已挂载 gsh-backups 卷）
# GSH_BACKUPS_ROOT=/var/lib/game-server-hub/backups
# GSH_INSTALL_SEED_ENABLED=1
# 连续安装间隔毫秒，默认 4000；压力测试可保持默认以串行 app_update
# GSH_STEAMCMD_INTER_JOB_COOLDOWN_MS=4000
# 国内服务器 SteamCMD 下载优化（推荐）
# GSH_STEAMCMD_DOWNLOAD_REGION=cn
# GSH_STEAMCMD_INSTALL_MAX_ATTEMPTS=8
# GSH_STEAMCMD_INSTALL_RETRY_DELAYS_MS=5000,10000,15000,20000,25000,30000,35000
#
# Mod 市场（Steam 创意工坊列表）与 Mod 订阅下载相关配置：
# GSH_STEAM_WEBAPI_KEY=your_steam_web_api_key
#   启用官方 Web API 拉取 Mod 市场，稳定性高于 HTML 抓取
# GSH_STEAM_RELAY_URL=https://your-relay.example/steam
# GSH_STEAM_RELAY_TOKEN=your_relay_token
#   无法直连 Steam 时可走海外中继
# GSH_STEAM_WORKSHOP_FETCH_TIMEOUT_MS=12000
#   Mod 市场 live 拉取超时（毫秒），网络慢时可适当上调
# GSH_STEAM_WORKSHOP_WARM_CACHE=0
#   设为 0 可关闭面板启动时后台预热默认 Mod 市场列表
# GSH_STEAM_WORKSHOP_DISABLE_DISK_CACHE=1
#   调试时可关闭 Mod 市场磁盘缓存
# 若区域强制仍失败，可配置代理（映射为 SteamCMD 容器 http_proxy/https_proxy）
# GSH_STEAMCMD_HTTPS_PROXY=http://127.0.0.1:7890
# GSH_STEAMCMD_NO_PROXY=localhost,127.0.0.1
# 持续 CDN 超时时可尝试 host 网络（需重启面板）
# GSH_STEAMCMD_NETWORK_MODE=host
# 实例控制台「直连代码」：默认自动探测云服务器公网 IP（云元数据 + 出站探测）
# 仅多网卡/NAT 等特殊环境需手动覆盖：
# GSH_DST_CONNECT_HOST=203.0.113.10
# 关闭公网自动探测（须配合 GSH_DST_CONNECT_HOST，否则公网直连显示占位符；局域网请用控制台「局域网」切换）
# GSH_DST_AUTO_PUBLIC_IP=0
# Windows 开发调试（WSL2 / Docker Desktop / Rancher Desktop）：容器内看不到宿主网卡，
# 且出站探测可能被系统代理接管而返回代理出口地址。此时建议：
#   GSH_DST_AUTO_PUBLIC_IP=0
#   GSH_DST_CONNECT_HOST=127.0.0.1   # 依赖宿主侧把容器端口转发到 127.0.0.1（WSL 原生 docker 下不确定，需实测）
# 注意：该组合仅用于本机开发调试，不要用到云服务器上——云上应保留自动探测（元数据拿到的才是真实公网 IP）。
# 多实例同机时可限制 DST 运行容器资源（0 或未设置表示不限制）
# GSH_DST_CONTAINER_MEMORY_MB=2048
# GSH_DST_CONTAINER_CPU_QUOTA=1.5
# 同机第二实例：从已停止实例复制游戏文件，跳过 Steam 下载（默认开启）
# GSH_INSTALL_SEED_ENABLED=1
# 安装完成时不 pull DST 运行镜像，首次启动时再拉取（默认开启）
# GSH_INSTALL_DEFER_DST_IMAGE_PULL=1
# 资源 NDJSON 写入 gsh-data 卷：/app/data/install-logs/<instanceId>.resource.ndjson 与 _host.resource.ndjson
#
# 内存说明（dev:compose ≠ 生产）：
# - dev:compose 跑 panel(tsx watch)+web(Vite 热更新) 两个 Node 容器，合计 ~1GiB+ 属开发常态，不代表生产镜像
# - 生产 PANEL_IMAGE 单容器：Fastify + 已构建的 dist 静态资源，通常明显低于 dev
# - 仅 docker-compose.dev.yml 生效：GSH_PANEL_MEMORY_LIMIT / GSH_WEB_MEMORY_LIMIT
# GSH_PANEL_MEMORY_LIMIT=3G
# GSH_WEB_MEMORY_LIMIT=1536M
PANEL_IMAGE=ghcr.io/pmat77/game-server-hub:v0.3.1
GSH_STACK_DIR=/opt/game-server-hub
GSH_COMPOSE_FILES=docker-compose.yml:docker-compose.bind.yml
GSH_GITHUB_REPO=PMAT77/game-serve-hub
