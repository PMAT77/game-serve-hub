{
  "name": "game-server-hub",
  "type": "module",
  "version": "0.1.4",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "postinstall": "pnpm -r --filter './packages/*' run stub --if-present",
    "dev": "pnpm run dev:prepare && run-p dev:web dev:server:watch",
    "dev:prepare": "pnpm -r --filter './packages/*' run stub --if-present && tsx ./server/scripts/dev.prepare.ts",
    "dev:web": "vite",
    "dev:server": "tsx ./server/src/main.ts",
    "dev:server:watch": "tsx watch ./server/src/main.ts",
    "dev:server:stop": "tsx ./server/scripts/stop.ts",
    "dev:compose:prepare": "tsx server/scripts/ensure-steamcmd-image.ts",
    "dev:compose": "tsx scripts/dev-compose.ts",
    "dev:compose:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "auth:repair-permissions": "tsx server/scripts/repair-user-permissions.ts",
    "install:linux": "bash ./scripts/install.linux.sh",
    "db:generate": "drizzle-kit generate --config server/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config server/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config server/drizzle.config.ts",
    "build": "vue-tsc -b && vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:native": "node scripts/build-native-release.mjs",
    "build:test": "vue-tsc -b && vite build --mode test",
    "serve": "http-server ./dist -o",
    "serve:test": "http-server ./dist-test -o",
    "svgo": "svgo -f src/assets/icons",
    "generate:icons": "tsx ./scripts/generate.icons.ts",
    "webp:to-png": "tsx ./scripts/webp-to-png.ts",
    "lint": "vue-tsc -b",
    "lint:ox": "oxlint --deny-warnings .",
    "test:server": "tsx --test server/src/**/*.test.ts",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "release:verify": "node scripts/check-release-consistency.mjs",
    "release:check": "pnpm run release:verify && pnpm run lint && pnpm test:unit && pnpm run build"
  },
  "dependencies": {
    "@fantastic-admin/components": "workspace:*",
    "@fantastic-admin/settings": "workspace:*",
    "@fantastic-admin/types": "workspace:*",
    "@fastify/cors": "catalog:",
    "@fastify/static": "catalog:",
    "@vee-validate/zod": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/integrations": "catalog:",
    "axios": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "dayjs": "catalog:",
    "dockerode": "catalog:",
    "drizzle-orm": "catalog:",
    "echarts": "catalog:",
    "eruda": "catalog:",
    "es-toolkit": "catalog:",
    "fastify": "catalog:",
    "hotkeys-js": "catalog:",
    "lucide-vue-next": "catalog:",
    "mitt": "catalog:",
    "nprogress": "catalog:",
    "path-browserify": "catalog:",
    "path-to-regexp": "catalog:",
    "pidusage": "^4.0.1",
    "pinia": "catalog:",
    "pinia-plugin-persistedstate": "catalog:",
    "pinyin-pro": "catalog:",
    "reka-ui": "catalog:",
    "scule": "catalog:",
    "tailwind-merge": "catalog:",
    "tsx": "catalog:",
    "ua-parser-js": "catalog:",
    "vconsole": "catalog:",
    "vee-validate": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@faker-js/faker": "catalog:",
    "@fantastic-admin/copyright": "workspace:*",
    "@fantastic-admin/themes": "workspace:*",
    "@iconify/json": "catalog:",
    "@iconify/vue": "catalog:",
    "@spiriit/vite-plugin-svg-spritemap": "catalog:",
    "@types/dockerode": "catalog:",
    "@types/nprogress": "catalog:",
    "@types/path-browserify": "catalog:",
    "@unocss/core": "catalog:",
    "@vitejs/plugin-legacy": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue/tsconfig": "catalog:",
    "drizzle-kit": "catalog:",
    "esbuild": "^0.28.0",
    "http-server": "catalog:",
    "naive-ui": "catalog:naive-ui",
    "npm-run-all2": "catalog:",
    "oxlint": "^1.81.0",
    "postcss": "catalog:",
    "postcss-nested": "catalog:",
    "sass-embedded": "catalog:",
    "sharp": "^0.34.5",
    "svgo": "catalog:",
    "unbuild": "catalog:",
    "unocss": "catalog:",
    "unocss-preset-animations": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-turbo-console": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vite-plugin-app-loading": "catalog:",
    "vite-plugin-archiver": "catalog:",
    "vite-plugin-compression2": "catalog:",
    "vite-plugin-env-parse": "catalog:",
    "vite-plugin-fake-server": "catalog:",
    "vite-plugin-vue-devtools": "catalog:",
    "vue-tsc": "catalog:"
  }
}
