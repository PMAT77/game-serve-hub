# Copy to panel.env for docker compose (install script writes panel.env automatically).
PANEL_PORT=3000
# dev:compose 默认不打印每条 HTTP 请求；排查 API 时可设 LOG_LEVEL=debug
# LOG_LEVEL=info
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 安装时为管理员标记「下次首次登录」弹出改密建议（仅提示一次，非强制拦截）
FORCE_PASSWORD_CHANGE=1
GSH_EDITION=community
DOCKER_HOST=unix:///var/run/docker.sock
GSH_GAME_DST_IMAGE=ghcr.io/pmat77/game-server-hub-dst:latest
# Docker Hub 镜像；国内网络若拉取失败，请配置 Docker registry-mirrors，或改为可访问的加速地址
GSH_STEAMCMD_IMAGE=cm2network/steamcmd:root-bookworm
# 饥荒 343050 专用服务器：建议配置 Steam 账号（游戏免费，库中需有饥荒联机版）
# STEAMCMD_USERNAME=your_steam_account
# STEAMCMD_PASSWORD=your_steam_password
# 可选：SteamCMD 子容器运行用户，默认 1000:1000；userns-remap / 需 root 写卷时可设 0:0
# GSH_STEAMCMD_RUN_USER=1000:1000
# 可选：RHEL/CentOS SELinux 下卷挂载追加选项，如 rw,z
# GSH_STEAMCMD_BIND_OPTS=rw,z
PANEL_IMAGE=ghcr.io/pmat77/game-server-hub:latest
GSH_STACK_DIR=/opt/game-server-hub
GSH_COMPOSE_FILES=docker-compose.yml:docker-compose.bind.yml
GSH_GITHUB_REPO=PMAT77/game-server-hub
